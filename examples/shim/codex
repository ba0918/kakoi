#!/usr/bin/env bash
#
# A shim template for the Codex CLI (specification section 16 of process-wrap).
#
# Copy it somewhere on your PATH ahead of the real codex, for example
# ~/.local/bin/codex, and make it executable. Every codex invocation then goes
# through process-wrap, which builds the boundary from your profile.
#
# What it does:
#   - classifies the invocation: the forms where the agent may run commands go
#     into the isolation, everything else is passed straight to the real codex;
#   - inserts --dangerously-bypass-approvals-and-sandbox into the isolated
#     forms, because the boundary is process-wrap's and codex's own sandbox
#     would only narrow it in ways that change per turn;
#   - copies --cd/-C to --workspace and --add-dir to --rw, so that the place
#     codex works in is the place process-wrap opens for writing (codex keeps
#     its own copies of those options; nothing is removed);
#   - creates /tmp/process-wrap if it is not there, the one directory shared
#     with the host (process-wrap never creates it);
#   - execs process-wrap. Nesting is not this shim's business: process-wrap
#     detects PROCESS_WRAP=1 itself and warns.
#
# PROCESS_WRAP_SHIM_OFF=1 execs the real codex with your arguments unchanged
# and no bypass flag: codex runs under its own sandbox, outside process-wrap.
# Use it to run something that must reach what the profile hides, such as a
# setup skill that writes the configuration directory.
#
# Keeping the classification current: the two lists below are from codex-cli
# 0.153.4. After a codex upgrade, run `codex --help` and check that every
# subcommand it lists is in one of them. A bare word in neither list is read as
# a prompt, that is, as the interactive session, which is what codex itself
# does; a subcommand added by a newer codex and left out of the lists would
# therefore be given the bypass flag as a global option and might be refused by
# codex. Only the four forms in is_isolated_subcommand accept that flag, so
# check `codex <name> --help` before adding one there.
#
# To see what process-wrap makes of an isolated invocation, run the same
# command by hand with --print-plan in front of the `--`:
#     process-wrap --workspace "$PWD" --print-plan -- codex ...
# The plan shows the mount items, the variables, and the bwrap arguments.

set -euo pipefail

readonly BYPASS_FLAG=--dangerously-bypass-approvals-and-sandbox
readonly SHARED_DIR=/tmp/process-wrap

self=$(realpath "${BASH_SOURCE[0]}")

fail() {
	printf 'codex (process-wrap shim): %s\n' "$*" >&2
	exit 127
}

# The real codex: the first executable named codex on PATH that is not this
# shim. Comparing real paths keeps a link to the shim from being taken for it.
resolve_codex() {
	local dir candidate
	local IFS=:
	for dir in ${PATH:-}; do
		candidate="${dir:-.}/codex"
		[ -x "${candidate}" ] && [ ! -d "${candidate}" ] || continue
		[ "$(realpath "${candidate}")" != "${self}" ] || continue
		printf '%s\n' "${candidate}"
		return 0
	done
	fail 'no codex found on PATH besides this shim'
}

# Top-level options that take the following word as their value, so that the
# value is never mistaken for the subcommand (`codex -m NAME exec` and so on).
takes_a_value() {
	case "$1" in
	-c | --config | -i | --image | -m | --model | -p | --profile | -s | --sandbox | \
		-a | --ask-for-approval | -C | --cd | --add-dir | --enable | --disable | \
		--remote | --remote-auth-token-env | --local-provider)
		return 0
		;;
	esac
	return 1
}

# The forms where the agent may run commands, including the interactive session
# (no subcommand at all). These are also the four that accept the bypass flag.
is_isolated_subcommand() {
	case "$1" in
	exec | e | resume | fork) return 0 ;;
	esac
	return 1
}

# The forms that run no agent: authentication, servers, session bookkeeping,
# diagnostics, version and completion output.
is_passed_through_subcommand() {
	case "$1" in
	agents | review | login | logout | mcp | plugin | mcp-server | app-server | \
		remote-control | completion | update | doctor | sandbox | debug | apply | a | \
		queue | archive | delete | unarchive | migrate-rollouts | cloud | exec-server | \
		features | help)
		return 0
		;;
	esac
	return 1
}

isolate=true
interactive=true
workspace="${PWD}"
rw_dirs=()
codex_args=()
subcommand_seen=false
prompt_reached=false

arguments=("$@")
index=0
while [ "${index}" -lt "${#arguments[@]}" ]; do
	argument="${arguments[${index}]}"
	if [ "${prompt_reached}" = true ]; then
		codex_args+=("${argument}")
		index=$((index + 1))
		continue
	fi
	case "${argument}" in
	--)
		# Everything after `--` is the prompt: no option and no subcommand.
		prompt_reached=true
		codex_args+=("${argument}")
		;;
	-h | --help | -V | --version)
		isolate=false
		codex_args+=("${argument}")
		;;
	--cd=* | -C=*)
		workspace="${argument#*=}"
		codex_args+=("${argument}")
		;;
	--add-dir=*)
		rw_dirs+=("${argument#*=}")
		codex_args+=("${argument}")
		;;
	-*)
		codex_args+=("${argument}")
		if takes_a_value "${argument}" && [ $((index + 1)) -lt "${#arguments[@]}" ]; then
			value="${arguments[$((index + 1))]}"
			case "${argument}" in
			-C | --cd) workspace="${value}" ;;
			--add-dir) rw_dirs+=("${value}") ;;
			esac
			codex_args+=("${value}")
			index=$((index + 1))
		fi
		;;
	*)
		codex_args+=("${argument}")
		if [ "${subcommand_seen}" = false ]; then
			subcommand_seen=true
			if is_isolated_subcommand "${argument}"; then
				interactive=false
				codex_args+=("${BYPASS_FLAG}")
			elif is_passed_through_subcommand "${argument}"; then
				interactive=false
				isolate=false
			fi
			# A word in neither list is a prompt, so the form stays the
			# interactive session.
		fi
		;;
	esac
	index=$((index + 1))
done

codex=$(resolve_codex)

if [ "${PROCESS_WRAP_SHIM_OFF:-}" = 1 ] || [ "${isolate}" = false ]; then
	exec "${codex}" "$@"
fi

# The interactive session has no subcommand to put the flag after, so it goes in
# front of everything, where codex reads its global options.
if [ "${interactive}" = true ]; then
	codex_args=("${BYPASS_FLAG}" ${codex_args[@]+"${codex_args[@]}"})
fi

mkdir -p "${SHARED_DIR}"

process_wrap_args=(--workspace "${workspace}")
for dir in ${rw_dirs[@]+"${rw_dirs[@]}"}; do
	process_wrap_args+=(--rw "${dir}")
done

# The resolved path, not the name: inside the isolation `codex` would find this
# shim again on PATH and the pair would call each other for ever.
exec process-wrap "${process_wrap_args[@]}" -- "${codex}" ${codex_args[@]+"${codex_args[@]}"}
