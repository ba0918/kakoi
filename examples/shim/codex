#!/usr/bin/env bash
#
# A shim template for process-wrap (specification section 16).
#
# Copy it to a directory that comes before the wrapped command on your PATH,
# name the copy after that command, fill in the tool section below, and make it
# executable. Every invocation of that name then goes through process-wrap,
# which builds the boundary from your profile. The body below the tool section
# does not depend on the command being wrapped; the values shipped in the tool
# section are an example, filled in for the Codex CLI.
#
# Everything is isolated by default. `--help` and `--version` are no exception,
# and nothing here decides from a subcommand whether isolation is needed, so a
# subcommand that a newer version of the wrapped command adds is isolated like
# any other. There are two ways out, and both are yours to open:
#
#   - PROCESS_WRAP_SHIM_OFF=1 execs the real command with your arguments
#     unchanged and no flag inserted, outside process-wrap. It takes nothing
#     away that you did not already have: process-wrap trusts the host it is
#     started from.
#   - a subcommand in the allow list is passed straight through, with its
#     arguments unchanged and no flag inserted. Nothing is created in /tmp on
#     that path either.
#
# Both lists ship empty. Add a name only when something breaks, and only the
# one that broke:
#
#   | What broke                                     | Where the name goes    |
#   |------------------------------------------------|------------------------|
#   | the command refuses the flag, or takes it and   | the no-flag list       |
#   | it has no effect                                |                        |
#   | it cannot reach the host from inside the        | the allow list, once   |
#   | isolation, and no model runs                    | you have approved it   |
#   | a model runs and it still breaks inside the     | neither list; fix the  |
#   | isolation                                       | profile instead        |
#
# Before you put a name in the allow list, check that no model runs while it
# executes: that the wrapped command asks no model and cannot run a command a
# model produced (specification section 2). Read the command's documentation
# and watch a run of it. For codex, the header printed at start-up and the
# output of `exec` are where that shows. The subcommand most likely to end up
# there first is the one that authenticates — `login` in codex's case. That is
# a reading of its help text, not a measurement, and it is not shipped in the
# list below: check it yourself before you trust it.
#
# Filling in the tool section for another command: REAL_COMMAND is the name of
# the executable to look for on PATH. BYPASS_FLAG is the flag that turns the
# command's own sandbox off, or empty if it has none — the boundary is
# process-wrap's, and a sandbox of the command's own would only narrow it in
# ways that change from turn to turn. WORKSPACE_OPTIONS and RW_OPTIONS are the
# options whose values name a directory the command works in, which become
# process-wrap's --workspace and --rw. Read all of these off the command's
# `--help`. A value is read when it is written as the following word, attached
# with `=`, or, for a one-letter option, attached to the option; an option
# whose value is written in some other way is not copied, and then the command
# is refused a directory rather than given one. The other direction is the one
# misreading that widens the boundary: nothing here knows which of the
# command's other options take a value, so a word equal to a copied option's
# name is read as that option wherever it stands — the value of another
# option, or a positional argument — and --workspace or --rw widens to what
# follows it. `codex -m --cd /etc exec` sends process-wrap `--workspace /etc`.
# Nothing after `--` is read.
#
# Checking a copy of this template without running the real command: put two
# directories at the front of PATH, one holding your copy under the wrapped
# command's name, the other holding stand-ins for the wrapped command and for
# process-wrap that print their arguments and exit 0. The copy finds the
# stand-in as the real command, and what the stand-ins print is the whole of
# what this shim decided. Point SHARED_DIR somewhere writable of your own while
# you do that. To see what process-wrap makes of an isolated invocation, run it
# by hand with --print-plan in front of the `--`:
#     process-wrap --workspace "$PWD" --print-plan -- codex ...
# The plan shows the mount items, the variables, and the bwrap arguments.

# ---------------------------------------------------------------------------
# Tool section: the values for the command being wrapped. Shipped filled in for
# codex, which is an example of a command to wrap, not a requirement of
# process-wrap.
# ---------------------------------------------------------------------------

# The name of the real executable to look for on PATH.
readonly REAL_COMMAND=codex

# The flag that turns the wrapped command's own sandbox off, inserted at the
# front of the argument list, where a command reads its global options. Empty
# if the command has no such flag; nothing is inserted then.
readonly BYPASS_FLAG=--dangerously-bypass-approvals-and-sandbox

# The options whose value is a directory to copy to process-wrap's --workspace
# and --rw. The last --workspace wins; every --rw is passed on.
readonly WORKSPACE_OPTIONS=(--cd -C)
readonly RW_OPTIONS=(--add-dir)

# Subcommands passed straight through to the real command, outside
# process-wrap. Empty as shipped: put a name here only after checking that no
# model runs while it executes.
readonly ALLOW_LIST=()

# Subcommands that go through process-wrap but without BYPASS_FLAG in front.
# Empty as shipped: put a name here when the command refuses the flag or takes
# it without effect.
readonly NO_FLAG_LIST=()

# ---------------------------------------------------------------------------
# Nothing below this line is specific to the command being wrapped.
# ---------------------------------------------------------------------------

set -euo pipefail

readonly SHARED_DIR=/tmp/process-wrap

self=$(realpath "${BASH_SOURCE[0]}")

fail() {
	printf '%s (process-wrap shim): %s\n' "${REAL_COMMAND}" "$*" >&2
	exit 127
}

# The real command: the first executable of that name on PATH that is not this
# shim. Comparing real paths keeps a link to the shim from being taken for it.
# What is passed on is the path as found on PATH rather than what it resolves
# to, so a version manager's own shim keeps the name it dispatches on.
resolve_real_command() {
	local dir candidate
	local IFS=:
	for dir in ${PATH:-}; do
		candidate="${dir:-.}/${REAL_COMMAND}"
		[ -x "${candidate}" ] && [ ! -d "${candidate}" ] || continue
		[ "$(realpath "${candidate}")" != "${self}" ] || continue
		printf '%s\n' "${candidate}"
		return 0
	done
	fail "no ${REAL_COMMAND} found on PATH besides this shim"
}

# Whether a word is in a list. Only the first word of the argument list is ever
# looked up: an argument list that starts with an option matches nothing and is
# isolated as usual, which puts a misreading on the isolating side.
in_list() {
	local needle=$1
	shift
	local name
	for name in "$@"; do
		if [ "${name}" = "${needle}" ]; then
			return 0
		fi
	done
	return 1
}

# The value an option carries, written as the following word (`-C DIR`),
# attached with `=` (`--cd=DIR`, `-C=DIR`), or attached to a one-letter option
# (`-CDIR`). Sets option_value and option_words, the number of words the option
# and its value occupy together.
read_option_value() {
	local option=$1 argument=$2 next_exists=$3 next=${4-}
	case "${argument}" in
	"${option}")
		[ "${next_exists}" = true ] || return 1
		option_value=${next}
		option_words=2
		return 0
		;;
	"${option}"=*)
		option_value=${argument#*=}
		option_words=1
		return 0
		;;
	esac
	# Only a one-letter option can carry its value attached to it.
	case "${option}" in
	-?) ;;
	*) return 1 ;;
	esac
	case "${argument}" in
	"${option}"?*)
		option_value=${argument#"${option}"}
		option_words=1
		return 0
		;;
	esac
	return 1
}

first_word=${1-}
real_command=$(resolve_real_command)

if [ "${PROCESS_WRAP_SHIM_OFF:-}" = 1 ] ||
	in_list "${first_word}" ${ALLOW_LIST[@]+"${ALLOW_LIST[@]}"}; then
	exec "${real_command}" "$@"
fi

command_args=("$@")
if [ -n "${BYPASS_FLAG}" ] &&
	! in_list "${first_word}" ${NO_FLAG_LIST[@]+"${NO_FLAG_LIST[@]}"}; then
	command_args=("${BYPASS_FLAG}" "$@")
fi

# The place the command works in should be the place process-wrap opens for
# writing. The command keeps its own copies of these options; nothing is
# removed from what it is given.
workspace=${PWD}
rw_dirs=()

arguments=("$@")
option_value=
option_words=1
index=0
while [ "${index}" -lt "${#arguments[@]}" ]; do
	argument=${arguments[${index}]}
	# Nothing after `--` is an option of the wrapped command.
	if [ "${argument}" = -- ]; then
		break
	fi
	next_exists=false
	next=
	if [ $((index + 1)) -lt "${#arguments[@]}" ]; then
		next_exists=true
		next=${arguments[$((index + 1))]}
	fi
	option_words=1
	matched=false
	for option in ${WORKSPACE_OPTIONS[@]+"${WORKSPACE_OPTIONS[@]}"}; do
		if read_option_value "${option}" "${argument}" "${next_exists}" "${next}"; then
			workspace=${option_value}
			matched=true
			break
		fi
	done
	if [ "${matched}" = false ]; then
		for option in ${RW_OPTIONS[@]+"${RW_OPTIONS[@]}"}; do
			if read_option_value "${option}" "${argument}" "${next_exists}" "${next}"; then
				rw_dirs+=("${option_value}")
				break
			fi
		done
	fi
	index=$((index + option_words))
done

# mkdir -p takes a symbolic link to a directory for the directory itself, and
# process-wrap resolves the rw item to its real path. On a host where another
# local user can win the name, a link left here would make its target writable
# inside the isolation, and the boundary would not catch it: /tmp is hidden, not
# writable, so nothing on the way is inside a writable item.
if [ -L "${SHARED_DIR}" ]; then
	fail "${SHARED_DIR} is a symbolic link; remove it and let a real directory be made there"
fi
mkdir -p "${SHARED_DIR}"

process_wrap_args=(--workspace "${workspace}")
for dir in ${rw_dirs[@]+"${rw_dirs[@]}"}; do
	process_wrap_args+=(--rw "${dir}")
done

# Nesting is not this shim's business: process-wrap detects PROCESS_WRAP=1
# itself and warns.
exec process-wrap "${process_wrap_args[@]}" -- "${real_command}" ${command_args[@]+"${command_args[@]}"}
